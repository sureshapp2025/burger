<section class="offer_section layout_padding-bottom">
	<div class="offer_container">
		<div class="container">
			<div
				class="row">
				{# Loop referenced offer paragraphs #}
				{% for item in paragraph.field_offer_section %}
					{% set offer = item.entity %}

					<div class="col-md-6">
						<div
							class="box">

							{# Image #}
							<div class="img-box">
								{% if offer.field_offer_food_image.entity %}
									{% set media = offer.field_offer_food_image.entity %}
									{% if media.field_media_image.entity %}
										{% set image_url = file_url(media.field_media_image.entity.fileuri) %}
										<img src="{{ image_url }}" alt="{{ offer.field_offer_title.value }}">
									{% endif %}
								{% endif %}
							</div>

							<div
								class="detail-box">

								{# Title #}
								<h5>
									{{ offer.field_offer_title.value }}
								</h5>

								{# If you later add discount field, replace this #}
								<h6>
									<span>{{ offer.field_discount_content.value }}</span>
								</h6>

								<a href="#">
									Order Now
									{# keep your SVG here #}
								</a>

							</div>

						</div>
					</div>

				{% endfor %}

			</div>
		</div>
	</div>
</section>

{# Food section #}
<section class="food-section layout_padding-bottom">
	{{ drupal_view('burger_menu_page', 'block_1') }}
</section>
{# End food section #}

<section class="about_section layout_padding">
  <div class="container">

    <div class="row">

      {# LEFT SIDE IMAGE #}
      <div class="col-md-6">
        <div class="img-box">

          {% if paragraph.field_banner_background_image.entity %}
            {% set media = paragraph.field_banner_background_image.entity %}
            {% if media.field_media_image.entity %}
              {% set image_url = file_url(media.field_media_image.entity.fileuri) %}
              <img src="{{ image_url }}" alt="{{ paragraph.field_offer_title.value }}">
            {% endif %}
          {% endif %}

        </div>
      </div>

      {# RIGHT SIDE CONTENT #}
      <div class="col-md-6">
        <div class="detail-box">

          <div class="heading_container">
            <h2>
              {{ paragraph.field_offer_title.value }}
            </h2>
          </div>

          <p>
            {{ paragraph.field_banner_content.value|raw }}
          </p>

          <a href="#">
            Read More
          </a>

        </div>
      </div>

    </div>

  </div>
</section>

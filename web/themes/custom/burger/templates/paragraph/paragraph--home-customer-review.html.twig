{{ attach_library('burger/global') }}

<section class="client_section layout_padding-bottom">
	<div class="container">

		<div class="heading_container heading_center psudo_white_primary mb_45">
			<h2>
				What Says Our Customers
			</h2>
		</div>

		{% if paragraph.field_customer_comments is not empty %}
			<div class="carousel-wrap row">
				<div class="owl-carousel client_owl-carousel">

					{# Loop testimonials #}
					{% for item in paragraph.field_customer_comments %}
						{% set review = item.entity %}

						{% if review %}
							<div class="item">
								<div class="box">

									<div class="detail-box">
										<p>
											{{ review.field_customer_summary.value }}
										</p>

										<h6>
											{{ review.field_customer_name.value }}
										</h6>
									</div>

									<div class="img-box">
										{% if review.field_customer_image.entity %}
											{% set media = review.field_customer_image.entity %}
											{% if media.field_media_image.entity %}
												{% set image_uri = media.field_media_image.entity.uri.value %}
												{% set image_url = file_url(image_uri) %}
												<img src="{{ image_url }}" alt="{{ review.field_customer_name.value }}" class="box-img">
											{% endif %}
										{% endif %}
									</div>

								</div>
							</div>
						{% endif %}

					{% endfor %}

				</div>
			</div>
		{% endif %}

	</div>
</section>

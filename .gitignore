# Ignore core
/web/core/
/vendor/

# Ignore contributed modules/themes (if using Composer)
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# Ignore custom files (optional: remove if you want to track them)
/web/sites/*/files
/web/sites/*/private

# Ignore settings files
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml

# Ignore environment files
.env
.env.local

# Ignore IDE/editor files
/.idea/
/.vscode/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore logs
*.log

# Ignore node/npm
/node_modules/

# Ignore composer lock (optional)
# composer.lock